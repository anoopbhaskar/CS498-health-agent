APP_NAME=FitAgent
ENVIRONMENT=local
LOG_LEVEL=INFO

# Local SQLite database. Use a hosted DB URL later behind the same setting.
DATABASE_URL=sqlite:///var/fitagent.sqlite3

# Optional: retained for the legacy Claude CLI and future model-backed orchestration.
ANTHROPIC_API_KEY=
AGENT_MODEL=local-rules-v1
MAX_MEMORY_MESSAGES=12
